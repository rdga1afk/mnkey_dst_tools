# MonkeyDustToolsConfig.cmake -- generated by tools/CMakeLists.txt (install, component md_tools). #189 B: the ImGui third-party sources, the editor panels as the game embeds them and
# the character library, prebuilt by the tools repo CI. Imported targets keep the names of the in-tree targets (md_ui_third_party, md_game_panels, md_character). Commit @MD_TOOLS_SHA@.
# Headers are taken from the tools submodule of the consumer (${CMAKE_SOURCE_DIR}/tools): the consumer checks that it is the same commit.
if(TARGET md_game_panels)
    return()
endif()
get_filename_component(_mdt_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(MonkeyDustTools_SHA "@MD_TOOLS_SHA@")
set(_mdt_tp ${CMAKE_SOURCE_DIR}/tools/third_party)
foreach(_t md_ui_third_party md_game_panels md_character)
    add_library(${_t} STATIC IMPORTED GLOBAL)
endforeach()
set_target_properties(md_ui_third_party PROPERTIES IMPORTED_LOCATION "${_mdt_prefix}/lib/@MD_TOOLS_FILE_md_ui_third_party@"
    INTERFACE_INCLUDE_DIRECTORIES "${_mdt_tp}/imgui;${_mdt_tp}/imgui/backends;${_mdt_tp}/imgui-node-editor;${_mdt_tp}/ImGuiColorTextEdit;${_mdt_tp}/imnodes;${_mdt_tp}/imguizmo/src;${_mdt_tp}/imgui-flame-graph;${_mdt_tp}/imgui-command-palette"
    INTERFACE_LINK_LIBRARIES "monkey_dust::engine;SDL3::SDL3")
set_target_properties(md_game_panels PROPERTIES IMPORTED_LOCATION "${_mdt_prefix}/lib/@MD_TOOLS_FILE_md_game_panels@"
    INTERFACE_COMPILE_DEFINITIONS "MONKEY_DUST_EDITOR;DEBUG"
    INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/tools/editor;${CMAKE_SOURCE_DIR}/engine/src/render;${CMAKE_SOURCE_DIR}/engine/src/vendor"
    INTERFACE_LINK_LIBRARIES "md_ui_third_party;monkey_dust::engine")
set_target_properties(md_character PROPERTIES IMPORTED_LOCATION "${_mdt_prefix}/lib/@MD_TOOLS_FILE_md_character@"
    INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/tools/editor/character"
    INTERFACE_LINK_LIBRARIES "monkey_dust::engine")
unset(_mdt_tp)
