# Standalone mode of the tools repo (included by CMakeLists.txt when tools is the top project): what the private main repo's root CMakeLists.txt provides to its subprojects.
# The engine is the submodule tools/engine; SDL3 and Lua 5.4 come from the system (pacman: sdl3 lua54), glslang / SPIRV-Tools are fetched at the same pinned release as in main.
# Needs no private files; the translated shaders are not here, so the features that need them stay off (the game logs one `[GpuPipeline] missing shader` line per file).
enable_testing()
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

find_program(CCACHE_FOUND ccache)
if(CCACHE_FOUND)
    set(CMAKE_CXX_COMPILER_LAUNCHER ${CMAKE_COMMAND} -E env CCACHE_SLOPPINESS=pch_defines,time_macros,include_file_mtime,include_file_ctime ccache)
endif()
find_program(MOLD_FOUND mold)
if(MOLD_FOUND)
    add_link_options(-fuse-ld=mold)
else()
    find_program(LLD_FOUND lld)
    if(LLD_FOUND)
        add_link_options(-fuse-ld=lld)
    endif()
endif()

include(FetchContent)

option(MD_STATIC_DEPS "Build SDL3 and Lua from source (static, no system .so)" OFF)
option(MONKEY_DUST_BUILD_GAME  "Build the game executable"  ON)
option(MONKEY_DUST_BUILD_TOOLS "Build the editor and converters" ON)
option(MONKEY_DUST_EDITOR "Build the ImGui editor panels" ON)
option(MONKEY_DUST_BUILD_TESTS "Build the Google Test unit tests" ON)
option(MD_UI_TESTS "Link Dear ImGui Test Engine (licence: not a plain open-source one; never in a release)" OFF)
option(MD_PERF_TEST_HOOKS "Enable live perf-test Lua hooks without the ImGui editor overlay" OFF)
option(MONKEY_DUST_GAME_TESTS_ONLY "Build only game-specific tests" OFF)
option(MD_HLSL_RUNTIME "Build glslang (static) and the run-time HLSL compiler of path 1" ON)
set(MD_ENGINE_PREBUILT "" CACHE PATH "unused in standalone mode (the engine is built from the submodule)")

if(NOT EXISTS "${MD_ROOT}/engine/CMakeLists.txt")
    message(FATAL_ERROR "tools/engine is empty: run `git submodule update --init --recursive`")
endif()
find_package(SDL3 REQUIRED CONFIG)
set(MD_FONT_DIR ${MD_ROOT}/engine/src/vendor/fonts)
file(GLOB MD_FONT_TTFS ${MD_FONT_DIR}/*.ttf)
set(IMGUI_SOURCES)

add_subdirectory(engine)

if(MD_HLSL_RUNTIME)
    set(ENABLE_GLSLANG_BINARIES OFF CACHE BOOL "" FORCE)
    set(ENABLE_SPVREMAPPER OFF CACHE BOOL "" FORCE)
    set(ENABLE_OPT OFF CACHE BOOL "" FORCE)
    set(ENABLE_HLSL ON CACHE BOOL "" FORCE)
    set(ENABLE_CTEST OFF CACHE BOOL "" FORCE)
    set(GLSLANG_TESTS OFF CACHE BOOL "" FORCE)
    set(GLSLANG_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
    set(BUILD_EXTERNAL OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(glslang GIT_REPOSITORY https://github.com/KhronosGroup/glslang.git GIT_TAG vulkan-sdk-1.4.363.0 GIT_SHALLOW TRUE)
    FetchContent_MakeAvailable(glslang)
    set(MD_GLSLANG_INC ${glslang_SOURCE_DIR})
    FetchContent_Declare(spirv_headers GIT_REPOSITORY https://github.com/KhronosGroup/SPIRV-Headers.git GIT_TAG vulkan-sdk-1.4.363.0 GIT_SHALLOW TRUE)
    FetchContent_Declare(spirv_tools GIT_REPOSITORY https://github.com/KhronosGroup/SPIRV-Tools.git GIT_TAG vulkan-sdk-1.4.363.0 GIT_SHALLOW TRUE)
    set(SPIRV_SKIP_EXECUTABLES ON CACHE BOOL "" FORCE)
    set(SPIRV_SKIP_TESTS ON CACHE BOOL "" FORCE)
    set(SPIRV_WERROR OFF CACHE BOOL "" FORCE)
    set(SKIP_SPIRV_TOOLS_INSTALL ON CACHE BOOL "" FORCE)
    set(SPIRV_BUILD_FUZZER OFF CACHE BOOL "" FORCE)
    FetchContent_MakeAvailable(spirv_headers)
    set(SPIRV-Headers_SOURCE_DIR ${spirv_headers_SOURCE_DIR} CACHE PATH "" FORCE)
    FetchContent_MakeAvailable(spirv_tools)
endif()
